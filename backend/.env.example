# ─── Azure OpenAI ────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# ─── GitHub ──────────────────────────────────────────────
GITHUB_TOKEN=<your-pat-with-repo-scope>

# ─── Langfuse (cloud.langfuse.com) ───────────────────────
LANGFUSE_PUBLIC_KEY=<your-public-key>
LANGFUSE_SECRET_KEY=<your-secret-key>
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Sandbox ─────────────────────────────────────────────
# Host-side temp directory for per-run clones
SANDBOX_WORKDIR=./sandbox_workdir
# Docker image name built from docker/sandbox.Dockerfile
SANDBOX_IMAGE=repopilot-sandbox

# ─── Fixer ───────────────────────────────────────────────
MAX_FIXER_ATTEMPTS=3

# ─── App ─────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Absolute host path for docker run -v mount (required inside Docker Compose)
# Windows example: D:/projects/RepoPilot/backend/sandbox_workdir
# Linux example:   /home/user/RepoPilot/backend/sandbox_workdir
SANDBOX_WORKDIR_HOST=
